---
interface Props {
	title: string;
}

const { title } = Astro.props;
import { ClientRouter } from 'astro:transitions';
import Rain from "../components/Rain.astro";
import "../styles/global.css";


---

<!doctype html>
<html lang="es" transition:animate="none" style="background-color:#13151a;color-scheme:dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<meta name="msapplication-TileColor" content="#da532c">
		<meta name="theme-color" content="#13151a">
		<meta name="color-scheme" content="dark">
		<meta
        	name="description"
        	content="The Yellow Umbrella Website ☂️ "
      	/>
      	<meta
      	  name="keywords"
      	  content="YellowUmbrella, yellow, umbrella"
      	/>
      	<meta property="og:title" content="The Yellow Umbrella" />
      	<meta
      	  property="og:description"
      	  content="The Yellow Umbrella Website ☂️"
      	/>
      	<meta property="og:image" content="https://yellowumbrella.dev/card.png" />
      	<meta property="og:url" content="https://yellowumbrella.dev/" />
      	<meta property="twitter:domain" content="yellowumbrella.dev"/>
      	<meta property="twitter:url" content="https://yellowumbrella.dev/"/>
      	<meta name="twitter:title" content="The Yellow Umbrella"/>
      	<meta name="twitter:description" content="The Yellow Umbrella Website ☂️"/>
      	<meta name="twitter:card" content="summary_large_image" />
      	<meta name="twitter:image" content="https://yellowumbrella.dev/card.png"/>
		<ClientRouter />
	</head>
	<body class="no-scroll">
		<slot />
		<Rain />
	</body>
</html>
