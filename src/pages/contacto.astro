---
import Layout from "../layouts/Layout.astro";
import Head from "../components/Head.astro";
import { aparece } from "../lib/transiciones";

// Clave pública del widget (no es un secreto). En local se usa la de pruebas de Cloudflare,
// que siempre aprueba; ver .dev.vars.example.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "0x4AAAAAABuJW2nOZ7hkwydG";
---

<Layout title="Contacto – Yellow Umbrella">
  <Head />
  <div class="place-items-center m-4" transition:name="contenido" transition:animate={aparece}>
    <div class="flex place-content-center">
      <h1 class="text-white text-4xl text-center sm:text-6xl">Contacto</h1>
    </div>
    <div class="flex flex-col items-center mx-auto max-w-2xl mt-6 gap-4 px-4 sm:mt-10 text-center">
      <p class="text-white/70">Escríbenos y te responderemos lo antes posible.</p>

      <div id="correo" data-sitekey={siteKey} class="min-h-12 flex flex-col items-center gap-2" aria-live="polite">
        <button
          id="ver-correo"
          type="button"
          class="rounded-lg bg-[#ffd300] px-5 py-3 font-bold text-gray-900 hover:bg-white transition-colors focus-visible:ring-4 focus-visible:ring-[#773376] focus-visible:outline-none disabled:opacity-60"
        >
          Mostrar correo
        </button>
        <p id="correo-error" class="hidden text-sm text-white/70" role="alert"></p>
        <div id="turnstile" class="hidden"></div>
      </div>
    </div>
  </div>
</Layout>

<script>
  declare global {
    interface Window {
      turnstile?: {
        render: (el: string | HTMLElement, opts: Record<string, unknown>) => string;
        reset: (id?: string) => void;
        remove: (id?: string) => void;
      };
    }
  }

  const API = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";

  type Turnstile = NonNullable<Window["turnstile"]>;
  const listo = (t: Window["turnstile"]): t is Turnstile => typeof t?.render === "function";

  // api.js define window.turnstile al ejecutarse, pero lo rellena un instante después de "load":
  // se espera a que exista render() en vez de fiarse del evento.
  function cargarTurnstile(): Promise<Turnstile> {
    return new Promise((resolve, reject) => {
      const limite = Date.now() + 10_000;
      const esperar = () => {
        if (listo(window.turnstile)) return resolve(window.turnstile);
        if (Date.now() > limite) return reject(new Error("turnstile"));
        setTimeout(esperar, 50);
      };
      if (!document.querySelector(`script[src="${API}"]`)) {
        const s = document.createElement("script");
        s.src = API;
        s.async = true;
        s.onerror = () => reject(new Error("turnstile"));
        document.head.append(s);
      }
      esperar();
    });
  }

  function iniciar() {
    const caja = document.getElementById("correo");
    const boton = document.getElementById("ver-correo") as HTMLButtonElement | null;
    const error = document.getElementById("correo-error");
    const widget = document.getElementById("turnstile");
    if (!caja || !boton || !error || !widget || caja.dataset.listo) return;
    caja.dataset.listo = "1";

    const fallo = (texto: string) => {
      error.textContent = texto;
      error.classList.remove("hidden");
      boton.disabled = false;
      boton.textContent = "Reintentar";
    };

    const mostrar = (correo: string) => {
      const a = document.createElement("a");
      a.href = `mailto:${correo}`;
      a.textContent = correo;
      a.className =
        "text-xl break-all text-center font-bold sm:text-2xl md:text-3xl text-[#ffd300] underline decoration-[#773376] decoration-2 underline-offset-8 hover:text-white transition-colors";
      caja.replaceChildren(a);
    };

    const canjear = async (token: string) => {
      try {
        const r = await fetch("/api/correo", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ token }),
        });
        const datos = (await r.json()) as { correo?: string };
        if (r.ok && datos.correo) mostrar(datos.correo);
        else fallo("No hemos podido comprobar que eres una persona. Inténtalo de nuevo.");
      } catch {
        fallo("No hemos podido conectar. Inténtalo de nuevo.");
      }
    };

    boton.addEventListener("click", async () => {
      boton.disabled = true;
      boton.textContent = "Comprobando…";
      error.classList.add("hidden");
      try {
        const turnstile = await cargarTurnstile();
        widget.replaceChildren();
        // "interaction-only": es invisible y solo se muestra si Cloudflare necesita que la persona haga algo.
        turnstile.render(widget, {
          sitekey: caja.dataset.sitekey,
          appearance: "interaction-only",
          theme: "dark",
          callback: (token: string) => void canjear(token),
          "error-callback": () => fallo("La comprobación ha fallado. Inténtalo de nuevo."),
          "timeout-callback": () => fallo("La comprobación ha caducado. Inténtalo de nuevo."),
          "before-interactive-callback": () => widget.classList.remove("hidden"),
          "after-interactive-callback": () => widget.classList.add("hidden"),
        });
      } catch {
        fallo("No se ha podido cargar la comprobación. Inténtalo de nuevo.");
      }
    });
  }

  document.addEventListener("astro:page-load", iniciar);
</script>
