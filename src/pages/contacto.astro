---
import Layout from "../layouts/Layout.astro";
import Head from "../components/Head.astro";
---

<Layout title="Contacto – Yellow Umbrella">
  <Head />
  <div class="place-items-center m-4">
    <div class="flex place-content-center">
      <h1 class="text-white text-6xl">Contacto</h1>
    </div>
    <div class="flex flex-col items-center mx-auto max-w-2xl mt-10 gap-4 text-center">
      <p class="text-white/70">Escríbenos y te responderemos lo antes posible.</p>
      <a
        href="mailto:info@yellowumbrella.dev"
        class="text-2xl md:text-3xl font-bold text-[#ffd300] underline decoration-[#773376] decoration-2 underline-offset-8 hover:text-white transition-colors"
      >
        info@yellowumbrella.dev
      </a>
    </div>
  </div>
</Layout>
