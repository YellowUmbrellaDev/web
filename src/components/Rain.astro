<canvas
  id="rain"
  aria-hidden="true"
  transition:persist
  style="position:fixed;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none"
></canvas>

<script>
  import { startRain } from '../scripts/rain';

  const canvas = document.getElementById('rain');
  if (canvas instanceof HTMLCanvasElement) startRain(canvas);
</script>
